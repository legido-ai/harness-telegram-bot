# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Comma-separated numeric Telegram user ids allowed to use the bot. Required.
TELEGRAM_ALLOWED_USER_IDS=11111111,22222222

# Optional comma-separated chat ids. When set, the bot only works in these
# chats. Leave empty to allow any chat that an allowlisted human uses.
TELEGRAM_ALLOWED_CHAT_IDS=

# Group trigger policy: "mention" (default) answers only mentions and replies.
# "all" answers every message from allowlisted humans in that chat.
TELEGRAM_TRIGGER=mention

# OpenCode V2 server. Defaults match a local server.
OPENCODE_API_URL=http://127.0.0.1:49374
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-me

# Where the bot keeps its SQLite state and temporary attachments.
DATA_DIR=/data

# Health and operator endpoint (bound to loopback inside the container).
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# Attachment limit in megabytes.
MAX_ATTACHMENT_MB=20

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
